# Optional: enables Gemini responses for questions outside the local college knowledge base
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: Gemini speech generation. Browser speech remains the fallback.
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_TTS_VOICE=Iapetus

# Local development defaults
PORT=8789
VITE_VOICE_SILENCE_MS=400
